{
  "info": {
    "name": "AI BlogNest API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Comprehensive Thunder Client & Postman Collection for AI BlogNest API with Real-time & Gemini features."
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": ["{{base_url}}"],
          "path": ["api", "health"]
        }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\",\n  \"role\": \"author\",\n  \"bio\": \"Full-stack engineer and AI writer\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Auth - Get Current Profile",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/profile",
          "host": ["{{base_url}}"],
          "path": ["api", "auth", "profile"]
        }
      }
    },
    {
      "name": "Blogs - Get All Blogs",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/blogs?page=1&limit=10&search=&category=&sort=newest",
          "host": ["{{base_url}}"],
          "path": ["api", "blogs"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "search", "value": "" },
            { "key": "category", "value": "" },
            { "key": "sort", "value": "newest" }
          ]
        }
      }
    },
    {
      "name": "Blogs - Get Blog By ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/blogs/{{blogId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "blogs", "{{blogId}}"]
        }
      }
    },
    {
      "name": "Blogs - Create Blog Post",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Architecting Real-Time Microservices with Node.js\",\n  \"content\": \"WebSockets and event-driven patterns empower modern APIs to push instant updates to millions of connected clients.\",\n  \"category\": \"Technology\",\n  \"tags\": [\"NodeJS\", \"WebSockets\", \"Microservices\"],\n  \"aiGenerated\": false\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/blogs",
          "host": ["{{base_url}}"],
          "path": ["api", "blogs"]
        }
      }
    },
    {
      "name": "Blogs - Update Blog",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated: Architecting Real-Time Microservices with Node.js\",\n  \"content\": \"Revised content detailing best practices for Socket.io clustering and horizontal scaling.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/blogs/{{blogId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "blogs", "{{blogId}}"]
        }
      }
    },
    {
      "name": "Blogs - Toggle Like",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/blogs/{{blogId}}/like",
          "host": ["{{base_url}}"],
          "path": ["api", "blogs", "{{blogId}}", "like"]
        }
      }
    },
    {
      "name": "Blogs - Delete Blog",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/blogs/{{blogId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "blogs", "{{blogId}}"]
        }
      }
    },
    {
      "name": "Comments - Add Comment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"blogId\": \"{{blogId}}\",\n  \"content\": \"Incredible insights! Really enjoyed reading this.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/comments",
          "host": ["{{base_url}}"],
          "path": ["api", "comments"]
        }
      }
    },
    {
      "name": "Comments - Get Comments by Blog",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/api/comments/blog/{{blogId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "comments", "blog", "{{blogId}}"]
        }
      }
    },
    {
      "name": "AI - Generate Blog with Gemini",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"How Generative AI is Reshaping Web Development in 2026\",\n  \"tone\": \"engaging\",\n  \"category\": \"Technology\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ai/generate-blog",
          "host": ["{{base_url}}"],
          "path": ["api", "ai", "generate-blog"]
        }
      }
    },
    {
      "name": "AI - Summarize Blog Content",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"content\": \"Artificial intelligence continues to accelerate productivity across engineering disciplines. By offloading routine boilerplate generation and unit test scaffolding, developers can focus on core domain architecture and high-level UX design.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ai/summarize",
          "host": ["{{base_url}}"],
          "path": ["api", "ai", "summarize"]
        }
      }
    },
    {
      "name": "AI - Generate Catchy Titles & SEO Keywords",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"Microservices Architecture Patterns\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/ai/generate-titles",
          "host": ["{{base_url}}"],
          "path": ["api", "ai", "generate-titles"]
        }
      }
    }
  ]
}
